# PostgreSQL
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow_db

# MinIO (S3-compatible artifact store)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me

# Airflow  — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here
# Airflow web UI admin login — pick your own; this used to be hardcoded admin/admin.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Model serving — the registered model and alias both the api and model-server follow
MODEL_NAME=stroke-model
MODEL_ALIAS=champion

# Training: the promotion gate. A new model replaces the champion only if its F2 beats the
# champion's in at least this share of bootstrap resamples of the test set.
GATE_MIN_P_BETTER=0.90

# gRPC model server
# How often, in seconds, it checks whether the champion alias moved (hot reload)
RELOAD_INTERVAL_S=10
# Threads serving calls, and the most calls in flight before new ones are refused
# with RESOURCE_EXHAUSTED (the API answers 503)
GRPC_MAX_WORKERS=8
GRPC_MAX_CONCURRENT_RPCS=32
# Deadline, in seconds, on every call the api makes to the model server (slower: 504)
RPC_TIMEOUT_S=2

# Streaming (docker compose --profile streaming): the stream worker closes a hospital's
# drift window after this many events. PSI needs a few hundred to tell drift from noise.
WINDOW_EVENTS=300


MUTATION_SAMPLE_RATE=0.80
MUTATION_NOISE_STD=0.03

API_KEYS=change_me
