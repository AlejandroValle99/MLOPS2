# Copy to .env and replace every value: none of these may stay as written here, and the
# empty ones must be filled before the stack starts. One way to make a secret:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# PostgreSQL
POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow_db

# MinIO (S3-compatible artifact store). Not minioadmin: that is MinIO's well-known default.
MINIO_ROOT_USER=stroke-minio
MINIO_ROOT_PASSWORD=change_me

# Airflow  — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here
# Airflow web UI admin login — pick your own; this used to be hardcoded admin/admin.
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me

# Model serving — the registered model and alias both the api and model-server follow
MODEL_NAME=stroke-model
MODEL_ALIAS=champion

# Training: the promotion gate. A new model replaces the champion only if its F2 beats the
# champion's in at least this share of bootstrap resamples of the test set.
GATE_MIN_P_BETTER=0.90

# gRPC model server
# How often, in seconds, it checks whether the champion alias moved (hot reload)
RELOAD_INTERVAL_S=10
# Threads serving calls, and the most calls in flight before new ones are refused
# with RESOURCE_EXHAUSTED (the API answers 503)
GRPC_MAX_WORKERS=8
GRPC_MAX_CONCURRENT_RPCS=32
# Deadline, in seconds, on every call the api makes to the model server (slower: 504)
RPC_TIMEOUT_S=2

# Streaming (docker compose --profile streaming): the stream worker closes a hospital's
# drift window after this many events. PSI needs a few hundred to tell drift from noise.
WINDOW_EVENTS=300
# The lake sink writes the stream's results to MinIO in files of this many messages, and
# writes the file still filling every LAKE_FLUSH_S seconds, so the newest results show up.
LAKE_BLOCK_RECORDS=1000
LAKE_FLUSH_S=30

# The retrain DAG's snapshot: the share of raw rows it keeps, and the noise it adds
MUTATION_SAMPLE_RATE=0.80
MUTATION_NOISE_STD=0.03

# REST API security. JWT_SECRET signs the callers' tokens (HS256); AUDIT_KEY keys the
# fingerprints of scored inputs in the audit log and must stay the same across restarts.
# Each must be at least 32 bytes, or the API refuses to start. Issue a token with:
#   docker compose exec api python -m api.security <subject> <predict|admin>
JWT_SECRET=
AUDIT_KEY=
# Predictions each caller may request per minute (429 past that)
RATE_LIMIT_PER_MINUTE=60

# The model server's clients: one key each, sent on every gRPC call. TLS to the model
# server uses the files ./scripts/make_certs.sh writes to certs/ (never committed).
MODEL_SERVER_KEY_API=
MODEL_SERVER_KEY_WORKER=
